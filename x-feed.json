      "reposts": 232
    },
    {
      "id": "2123946577010290737",
      "url": "https://x.com/NASAAdmin/status/2123946577010290737",
      "text": "Spent time with @USForcesJapan and @USSpaceForce Guardians at @YokotaAirBase. Always appreciate the opportunity to hear directly from our service members and learn more about their missions.\n\nTo the men and women serving far from home, thank you for your commitment, sacrifice, https://t.co/3mwE8AG9fV",
      "created_at": "2026-11-21T01:08:19.000Z",
      "name": "NASA Administrator Jared Isaacman",
      "username": "NASAAdmin",
      "avatar": "https://pbs.twimg.com/profile_images/2001755387486232576/mf5hRS_U_bigger.jpg",
      "image": "https://pbs.twimg.com/media/HXnGJjcbwAAgagU.jpg",
      "category": "aviation",
      "likes": 1199,
      "reposts": 126
    },
    {
      "id": "2123765302013923517",
      "url": "https://x.com/NASAAdmin/status/2123765302013923517",
      "text": "Good to see @JAXA_en President Yamakawa again, this time in Tokyo. We also met with Ministers Furukawa and Seki and members of Japan’s space policy community.\n\nJapan is one of our closest Moon Base partners. The Pressurized Rover Japan is developing will give astronauts the https://t.co/22WGdQieYh",
      "created_at": "2026-11-20T13:08:00.000Z",
      "name": "NASA Administrator Jared Isaacman",
      "username": "NASAAdmin",
      "avatar": "https://pbs.twimg.com/profile_images/2001755387486232576/mf5hRS_U_bigger.jpg",
      "image": "https://pbs.twimg.com/media/HXi3my0aEAEVvNs.jpg",
